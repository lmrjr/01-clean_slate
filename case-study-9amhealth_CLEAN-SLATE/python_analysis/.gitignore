# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Local environments and package build products
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Generated analysis results; retain the tracked directory marker.
outputs/*
!outputs/.gitkeep

# Editor and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
